node_modules/
# dev/ пересоздаётся сборкой (npm run build). Исключения ниже — источники
# графа заметок: они нужны в свежем checkout для CI/Docker и не генерируются.
dev/*
!dev/wiki/
dev/wiki/*
!dev/wiki/graph/
!dev/scripts/
dev/scripts/*
!dev/scripts/graph.js
!dev/scripts/graph/
!dev/styles/
dev/styles/*
!dev/styles/graph.css
!dev/vendor/
dev/vendor/*
!dev/vendor/d3-*.min.js
!dev/vendor/cytoscape.min.js
!dev/vendor/sigma.min.js
!dev/vendor/vis-network.min.js
!dev/vendor/force-graph.min.js
!dev/vendor/3d-force-graph.min.js
!dev/vendor/springy.js
!dev/vendor/joint.min.js
!dev/vendor/underscore-min.js
!dev/vendor/backbone-min.js
# Исходники новой игры: dev/ игнорируется целиком, поэтому каталог игры
# включаем явно; остальные подпапки dev/game/ остаются проигнорированными.
!dev/game/
dev/game/*
!dev/game/forgotten_peacemaker/
# Локальные заметки bio/job и их копия в сборке
src/notes/bio/job/
dist/src/notes/bio/job/
*.log
.env
.env.*
!.env.example
