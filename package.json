{
  "name": "zqwy",
  "version": "1.1.0",
  "private": true,
  "description": "Личный поисковый портал: логотип + поиск, каталог, темы",
  "type": "commonjs",
  "scripts": {
    "build": "bash scripts/build_dist.sh",
    "covers": "python3 scripts/build_covers.py",
    "catalog": "node scripts/build_music_catalog.mjs",
    "index": "node scripts/build_search_index.mjs",
    "version-info": "node scripts/build_version.mjs",
    "notes": "node scripts/build_wiki_notes.mjs",
    "fetch:tiddlywiki": "node scripts/fetch_tiddlywiki.mjs",
    "wiki:tiddlywiki": "node scripts/build_tiddlywiki.mjs",
    "test": "node --test scripts/lib/*.test.mjs",
    "verify:graph": "node scripts/verify_graph.mjs",
    "serve:dev": "python3 -m http.server 8080",
    "serve:dist": "python3 -m http.server 8080 --directory dist"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.51.2"
  }
}
